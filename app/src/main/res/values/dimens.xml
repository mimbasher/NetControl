<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Extra side padding so content does not stretch edge to edge on wide
         screens such as an unfolded foldable or a tablet. -->
    <dimen name="screen_gutter">0dp</dimen>
    <dimen name="card_padding">16dp</dimen>
    <dimen name="header_gap">10dp</dimen>
    <dimen name="row_padding_v">10dp</dimen>
    <!-- Landscape uses its own two pane layout, which spends the width on the
         list instead of on gutters, so it needs far less edge padding than the
         portrait screen_gutter above. -->
    <dimen name="screen_gutter_land">0dp</dimen>
</resources>
